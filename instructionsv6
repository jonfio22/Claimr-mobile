// Integration into claim submission flow
const ClaimSubmissionScreen = () => {
  const [claimData, setClaimData] = useState({
    equipment: null,
    description: '',
    attachments: [],
  });
  const [blueprintData, setBlueprintData] = useState(null);
  const [showBlueprint, setShowBlueprint] = useState(false);
  const [isSubmitting, setIsSubmitting] = useState(false);
  
  // Function to check if enough data is present to generate blueprint
  const canGenerateBlueprint = () => {
    return (
      claimData.equipment && 
      claimData.description.length > 10 && 
      claimData.attachments.length > 0
    );
  };
  
  // Fetch blueprint when sufficient data is available
  useEffect(() => {
    if (canGenerateBlueprint() && !blueprintData && !showBlueprint) {
      fetchBlueprint();
    }
  }, [claimData]);
  
  // Fetch blueprint from API
  const fetchBlueprint = async () => {
    try {
      setIsSubmitting(true);
      const response = await api.post('/api/agent/blueprint', {
        claim_id: claimData.id || 'draft',
        equipment: claimData.equipment,
        description: claimData.description,
        attachments: claimData.attachments,
        draft_metadata: {
          created_at: new Date().toISOString(),
          last_modified: new Date().toISOString(),
          completion_percentage: calculateCompletionPercentage(claimData)
        }
      });
      
      if (response.data.success) {
        setBlueprintData(response.data);
        setShowBlueprint(true);
      }
    } catch (error) {
      console.error('Error fetching blueprint:', error);
    } finally {
      setIsSubmitting(false);
    }
  };
  
  // Calculate completion percentage based on available data
  const calculateCompletionPercentage = (data) => {
    let score = 0;
    const weights = {
      equipment: 20,
      description: 30,
      attachments: 50
    };
    
    if (data.equipment) score += weights.equipment;
    if (data.description.length > 10) score += weights.description;
    if (data.attachments.length > 0) {
      score += (data.attachments.length / 3) * weights.attachments;
      if (score > 100) score = 100;
    }
    
    return Math.round(score);
  };
  
