     // In mobile app component
     useEffect(() => {
       const subscription = supabase
         .channel('claim-updates')
         .on(
           'postgres_changes',
           { event: 'UPDATE', schema: 'public', table: 'claims', filter: `id=eq.${claimId}` },
           (payload) => {
             updateClaimState(payload.new);
             
             // Show AI insights if available
             if (payload.new.ai_insights) {
               showAiInsightsPopup(payload.new.ai_insights);
             }
           }
         )
         .subscribe();
         
       return () => {
         subscription.unsubscribe();
       };
     }, [claimId]);
     ```

