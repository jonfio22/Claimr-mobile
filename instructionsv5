  activation_status TEXT NOT NULL, -- 'TRIGGERED', 'COMPLETED', 'FAILED', 'SKIPPED'
  result_status TEXT NOT NULL, -- 'VALID', 'INVALID', 'ERROR'
  confidence_score NUMERIC(5,2), -- tool-specific confidence
  input_parameters JSONB,
