// Status endpoint implementation
export default async function handler(
  req: NextApiRequest,
  res: NextApiResponse
) {
  if (req.method !== 'GET') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  try {
    // Get comprehensive system status
    const toolStatus = await validateAllTools();
    const schemaStatus = await validateAllSchemas();
    const connectionStatus = await validateAllConnections();
    
    // Calculate overall health metrics
    const overallHealth = calculateSystemHealth(toolStatus, schemaStatus, connectionStatus);
    
    return res.status(200).json({
      status: 'success',
      timestamp: new Date().toISOString(),
      health: overallHealth,
      details: {
        tools: toolStatus,
        schemas: schemaStatus,
        connections: connectionStatus
      }
    });
  } catch (error) {
    console.error('Error in linker status endpoint:', error);
    return res.status(500).json({ 
      status: 'error',
      message: 'Failed to retrieve linker status',
      timestamp: new Date().toISOString()
    });
  }
}
```

