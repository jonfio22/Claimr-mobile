### `/lib/agent/router.ts`

```typescript
// Intelligent routing layer that maps actions to the appropriate tools
import { AgentRequest, AgentResponse, RouterConfig } from './types';
import { toolchain } from './toolchain';

export class AgentRouter {
  private config: RouterConfig;
  
  constructor(config: RouterConfig = {}) {
    this.config = {
      defaultRoute: 'contextBuilder',
      ...config
    };
  }
  
  // Route the request to the appropriate handler based on action
  async route(request: AgentRequest): Promise<AgentResponse> {
    try {
      // Validate the request
      if (!request.action) {
        throw new Error('No action specified in request');
      }
      
      // Map actions to specific tools or sequences
      switch (request.action) {
        case 'analyzeClaim':
          return await this.handleClaimAnalysis(request);
          
        case 'getRecommendations':
          return await this.executeTool('recommendationEngine', request);
          
        case 'detectAnomalies':
          return await this.executeTool('anomalyDetector', request);
          
        case 'queryVault':
          return await this.executeTool('orgLearningVault', request);
          
        case 'trackMemory':
          return await this.executeTool('memoryTracker', request);
          
        case 'buildContext':
          return await this.executeTool('contextBuilder', request);
          
        default:
          // Check if there's a direct tool match
          if (toolchain[request.action]) {
            return await this.executeTool(request.action, request);
          }
          
          // Use fallback handler or default route
          if (this.config.fallbackHandler) {
            return await this.config.fallbackHandler(request);
          } else if (this.config.defaultRoute) {
            return await this.executeTool(this.config.defaultRoute, request);
          }
          
          throw new Error(`Unsupported action: ${request.action}`);
      }
    } catch (error) {
      console.error('Router error:', error);
      return {
        status: 'error',
        error: error.message,
        result: null
      };
    }
  }
  
  // Handle complex multi-tool sequences
  private async handleClaimAnalysis(request: AgentRequest): Promise<AgentResponse> {
    const toolsUsed = [];
    let context = { ...request };
    
    try {
      // Step 1: Build context
      const contextResult = await this.executeTool('contextBuilder', context);
      toolsUsed.push('contextBuilder');
      context = { ...context, ...contextResult.result };
      
      // Step 2: Detect anomalies
      const anomalyResult = await this.executeTool('anomalyDetector', context);
      toolsUsed.push('anomalyDetector');
      const anomalies = anomalyResult.result;
      
      // Step 3: Get recommendations
      const recommendationContext = { 
        ...context, 
        anomalies 
      };
      const recommendationResult = await this.executeTool('recommendationEngine', recommendationContext);
      toolsUsed.push('recommendationEngine');
      const recommendations = recommendationResult.result;
      
      // Step 4: Get org insights from vault
      const vaultResult = await this.executeTool('orgLearningVault', {
        ...context,
        query: { claimType: context.claimData?.type }
      });
      toolsUsed.push('orgLearningVault');
      const orgInsights = vaultResult.result;
      
      // Step 5: Track this interaction in memory
      await this.executeTool('memoryTracker', {
        sessionId: request.sessionId,
        action: 'store',
        data: { anomalies, recommendations, orgInsights }
      });
      toolsUsed.push('memoryTracker');
      
      // Generate explanation based on findings
      const explanation = this.generateExplanation({
        anomalies,
        recommendations,
        orgInsights,
        claimData: context.claimData
      });
      
      // Return the complete analysis
      return {
        status: 'success',
        result: {
          claim_analysis: {
            anomalies,
            recommendations,
            orgInsights
          }
        },
        explanation,
        toolsUsed
      };
    } catch (error) {
      console.error('Claim analysis error:', error);
      return {
        status: 'error',
        error: error.message,
        result: null,
        toolsUsed
      };
    }
  }
  
  // Execute a single tool from the toolchain
  private async executeTool(toolId: string, params: any): Promise<AgentResponse> {
    const tool = toolchain[toolId];
    
    if (!tool) {
      throw new Error(`Tool not found: ${toolId}`);
    }
    
    // Check for required context
    if (tool.requiredContext) {
      for (const key of tool.requiredContext) {
        if (params[key] === undefined) {
          throw new Error(`Missing required context for ${toolId}: ${key}`);
        }
      }
    }
    
    try {
      const result = await tool.execute(params);
      return {
        status: 'success',
        result,
        toolsUsed: [toolId]
      };
    } catch (error) {
      console.error(`Error executing ${toolId}:`, error);
      return {
        status: 'error',
        error: error.message,
        result: null,
        toolsUsed: [toolId]
      };
    }
  }
  
  // Generate a human-readable explanation based on the analysis
  private generateExplanation(data: any): string {
    const { anomalies, recommendations, claimData } = data;
    
    // Generate an explanation based on findings
    if (anomalies?.length > 0) {
      const topAnomaly = anomalies[0];
      const topRecommendation = recommendations?.[0]?.action || 'review further';
      
      return `This claim has ${anomalies.length} detected issue(s). ${topAnomaly.description}. Recommend to ${topRecommendation}.`;
    } else if (recommendations?.length > 0) {
      return `No anomalies detected. Recommended action: ${recommendations[0].action}.`;
    } else {
      return 'No significant findings. Claim appears to be standard.';
    }
  }
}
