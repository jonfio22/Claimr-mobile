## 5. Additional A2A and External System Integration

For integrating with external systems like A2A, Vertex AI, or Windsurf, we can add an adapter layer:

### `/lib/agent/adapters/a2a.ts`

```typescript
// Adapter for A2A (Agent-to-Agent) protocol integration
import { agent } from '../index';
import { AgentRequest } from '../types';

export class A2AAdapter {
  // Convert A2A message format to Claimr agent request
  static fromA2A(a2aMessage: any): AgentRequest {
    return {
      action: a2aMessage.intent || 'analyzeClaim',
      claimId: a2aMessage.entities?.claimId,
      orgId: a2aMessage.context?.orgId,
      context: {
        ...a2aMessage.context,
        source: 'a2a'
      },
      sessionId: a2aMessage.sessionId || `a2a_${Date.now()}`
    };
  }
  
  // Convert Claimr agent response to A2A message format
  static toA2A(agentResponse: any): any {
    return {
      status: agentResponse.status === 'success' ? 'completed' : 'failed',
      data: agentResponse.result,
      explanation: agentResponse.explanation,
      metadata: {
        toolsUsed: agentResponse.toolsUsed,
        timestamp: agentResponse.timestamp
      }
    };
  }
  
  // Process an A2A message and return A2A-formatted response
  static async processA2AMessage(a2aMessage: any): Promise<any> {
    // Convert incoming A2A message to agent request
    const request = this.fromA2A(a2aMessage);
    
    // Process with the agent
    const response = await agent.execute(request);
    
    // Convert response back to A2A format
    return this.toA2A(response);
  }
}
```

