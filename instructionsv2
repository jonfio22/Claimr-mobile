import { supabase } from '@/lib/supabaseClient';
import { 
  Organization,
  OrganizationVault,
  VaultType,
  VaultLogEntry,
  VaultEventType
} from './types';

export async function getOrganizationById(orgId: string): Promise<Organization | null> {
  const { data, error } = await supabase
    .from('organizations')
    .select('*')
    .eq('id', orgId)
    .single();
  
  if (error) {
    console.error('Error fetching organization:', error);
    return null;
  }
  
  return data;
}

export async function getVaultByType(orgId: string, vaultType: VaultType): Promise<OrganizationVault | null> {
  const { data, error } = await supabase
    .from('org_vaults')
    .select('*')
    .eq('org_id', orgId)
    .eq('vault_type', vaultType)
    .single();
  
  if (error) {
    console.error(`Error fetching vault ${vaultType}:`, error);
    return null;
  }
  
  return data;
}

export async function updateVault(
  orgId: string, 
  vaultType: VaultType, 
  newData: Record<string, any>,
  userId?: string
): Promise<boolean> {
  // First get the current vault data
  const vault = await getVaultByType(orgId, vaultType);
  
  if (!vault) {
    // Create new vault if it doesn't exist
    const { error } = await supabase
      .from('org_vaults')
      .insert({
        org_id: orgId,
        vault_type: vaultType,
        data: newData,
        version: 1
      });
    
    if (error) {
      console.error(`Error creating vault ${vaultType}:`, error);
      return false;
    }
    
    // Log the creation
    await logVaultEvent(orgId, vault.id, 'update', { 
      operation: 'create',
      data: newData 
    }, userId);
    
    return true;
  }
  
  // Merge existing data with new data
  const updatedData = {
    ...vault.data,
    ...newData
  };
  
  // Update the vault
  const { error } = await supabase
    .from('org_vaults')
    .update({ 
      data: updatedData,
      version: vault.version + 1
    })
    .eq('id', vault.id);
  
  if (error) {
    console.error(`Error updating vault ${vaultType}:`, error);
    return false;
  }
  
  // Log the update
  await logVaultEvent(orgId, vault.id, 'update', { 
    operation: 'update',
    previous_version: vault.version,
    data: newData 
  }, userId);
  
  return true;
}

export async function logVaultEvent(
  orgId: string,
  vaultId: string,
  eventType: VaultEventType,
  data: Record<string, any>,
  userId?: string,
  metrics: Record<string, any> = {}
): Promise<VaultLogEntry | null> {
  const { data: logEntry, error } = await supabase
    .from('org_vault_logs')
    .insert({
      org_id: orgId,
      vault_id: vaultId,
      event_type: eventType,
      data,
      created_by: userId,
      metrics
    })
    .select()
    .single();
  
  if (error) {
    console.error('Error logging vault event:', error);
    return null;
  }
  
  return logEntry;
}
