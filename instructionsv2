## 3. Core Learning Vault Service

```typescript
// /lib/org/OrgLearningVaultService.ts
import { 
  getVaultByType, 
  updateVault, 
  logVaultEvent 
} from './utils';
import { VaultType } from './types';
import { MCP7MemoryManager } from '@/lib/mcp7/MemoryManager';

export class OrgLearningVaultService {
  private orgId: string;
  private mcpManager: MCP7MemoryManager;
  
  constructor(orgId: string, mcpManager: MCP7MemoryManager) {
    this.orgId = orgId;
    this.mcpManager = mcpManager;
  }
  
  // Process a new claim for organizational learning
  async processClaimForLearning(claimData: any): Promise<void> {
    // Extract relevant patterns and update claim patterns vault
    const patterns = this.extractClaimPatterns(claimData);
    await this.updateClaimPatterns(patterns);
    
    // Update vendor insights based on claim
    if (claimData.vendor_id) {
      await this.updateVendorInsights(claimData.vendor_id, claimData);
    }
    
    // Update equipment trends
    if (claimData.equipment_id) {
      await this.updateEquipmentTrends(claimData.equipment_id, claimData);
    }
  }
  
  // Extract patterns from claim data
  private extractClaimPatterns(claimData: any): Record<string, any> {
    const { issue_type, resolution_time, approved, denial_reason, 
            resubmission_count, escalation_required } = claimData;
    
    return {
      issue_type: {
        type: issue_type,
        frequency: 1, // Will be aggregated
        avg_resolution_time: resolution_time,
        approval_rate: approved ? 1 : 0, // Will be averaged
      },
      resubmission_data: {
        count: resubmission_count,
        required_escalation: escalation_required
      },
      denial_reasons: denial_reason ? [denial_reason] : []
    };
  }
  
  // Update claim patterns in the organization vault
  async updateClaimPatterns(newPatterns: Record<string, any>): Promise<void> {
    const vault = await getVaultByType(this.orgId, 'claim_patterns');
    
    if (!vault) {
      await updateVault(this.orgId, 'claim_patterns', {
        patterns: {
          [newPatterns.issue_type.type]: newPatterns.issue_type
        },
        resubmission_stats: {
          counts: [newPatterns.resubmission_data.count],
          escalation_rate: newPatterns.resubmission_data.required_escalation ? 1 : 0
        },
        common_denial_reasons: newPatterns.denial_reasons
      });
      return;
    }
    
    // Merge existing patterns with new ones
    const existingData = vault.data;
    const issueType = newPatterns.issue_type.type;
    
    // Update or add issue type statistics
    if (existingData.patterns && existingData.patterns[issueType]) {
      const existing = existingData.patterns[issueType];
      existingData.patterns[issueType] = {
        type: issueType,
        frequency: existing.frequency + 1,
        avg_resolution_time: (existing.avg_resolution_time * existing.frequency + 
                             newPatterns.issue_type.avg_resolution_time) / (existing.frequency + 1),
        approval_rate: (existing.approval_rate * existing.frequency + 
                       newPatterns.issue_type.approval_rate) / (existing.frequency + 1)
      };
    } else if (existingData.patterns) {
      existingData.patterns[issueType] = {
        ...newPatterns.issue_type,
        frequency: 1
      };
    } else {
      existingData.patterns = {
        [issueType]: {
          ...newPatterns.issue_type,
          frequency: 1
        }
      };
    }
    
    // Update resubmission statistics
    if (existingData.resubmission_stats) {
      existingData.resubmission_stats.counts.push(newPatterns.resubmission_data.count);
      const escCount = existingData.resubmission_stats.counts.length;
      existingData.resubmission_stats.escalation_rate = 
        (existingData.resubmission_stats.escalation_rate * (escCount - 1) + 
        (newPatterns.resubmission_data.required_escalation ? 1 : 0)) / escCount;
    } else {
      existingData.resubmission_stats = {
        counts: [newPatterns.resubmission_data.count],
        escalation_rate: newPatterns.resubmission_data.required_escalation ? 1 : 0
      };
    }
    
    // Update denial reasons
    if (newPatterns.denial_reasons.length > 0) {
      if (existingData.common_denial_reasons) {
        existingData.common_denial_reasons = [
          ...existingData.common_denial_reasons,
          ...newPatterns.denial_reasons
        ];
      } else {
        existingData.common_denial_reasons = [...newPatterns.denial_reasons];
      }
    }
    
    await updateVault(this.orgId, 'claim_patterns', existingData);
  }
  
  // Update vendor insights based on a claim
  async updateVendorInsights(vendorId: string, claimData: any): Promise<void> {
    const vault = await getVaultByType(this.orgId, 'vendor_insights');
    const { 
      approved, 
      response_time, 
      denial_reason, 
      resolution_time,
      claim_id
    } = claimData;
    
    const newInsight = {
      vendor_id: vendorId,
      claims_processed: 1,
      approval_rate: approved ? 1 : 0,
      avg_response_time: response_time,
      avg_resolution_time: resolution_time,
      denial_reasons: denial_reason ? [denial_reason] : [],
      recent_claims: [claim_id]
    };
    
    if (!vault) {
      await updateVault(this.orgId, 'vendor_insights', {
        vendors: {
          [vendorId]: newInsight
        }
      });
      return;
    }
    
    // Update existing vendor data
    const existingData = vault.data;
    
    if (existingData.vendors && existingData.vendors[vendorId]) {
      const existing = existingData.vendors[vendorId];
      const newCount = existing.claims_processed + 1;
      
      existingData.vendors[vendorId] = {
        ...existing,
        claims_processed: newCount,
        approval_rate: (existing.approval_rate * existing.claims_processed + (approved ? 1 : 0)) / newCount,
        avg_response_time: (existing.avg_response_time * existing.claims_processed + response_time) / newCount,
        avg_resolution_time: resolution_time ? 
          (existing.avg_resolution_time * existing.claims_processed + resolution_time) / newCount :
          existing.avg_resolution_time,
        denial_reasons: denial_reason ? 
          [...existing.denial_reasons, denial_reason] : 
          existing.denial_reasons,
        recent_claims: [claim_id, ...existing.recent_claims].slice(0, 10) // Keep last 10 claims
      };
    } else if (existingData.vendors) {
      existingData.vendors[vendorId] = newInsight;
    } else {
      existingData.vendors = {
        [vendorId]: newInsight
      };
    }
    
    await updateVault(this.orgId, 'vendor_insights', existingData);
  }
  
  // Update equipment trends based on claim data
  async updateEquipmentTrends(equipmentId: string, claimData: any): Promise<void> {
    const vault = await getVaultByType(this.orgId, 'equipment_trends');
    const {
      issue_type,
      approved,
      equipment_age,
      claim_id,
      model,
      manufacturer
    } = claimData;
    
    const newTrend = {
      equipment_id: equipmentId,
      model: model,
      manufacturer: manufacturer,
      claims_count: 1,
      approval_rate: approved ? 1 : 0,
      issue_types: issue_type ? {[issue_type]: 1} : {},
      avg_age_at_failure: equipment_age || 0,
      recent_claims: [claim_id]
    };
    
    if (!vault) {
      await updateVault(this.orgId, 'equipment_trends', {
        equipment: {
          [equipmentId]: newTrend
        }
      });
      return;
    }
    
    // Update existing equipment data
    const existingData = vault.data;
    
    if (existingData.equipment && existingData.equipment[equipmentId]) {
      const existing = existingData.equipment[equipmentId];
      const newCount = existing.claims_count + 1;
      
      const updatedIssueCounts = {...existing.issue_types};
      if (issue_type) {
        updatedIssueCounts[issue_type] = (updatedIssueCounts[issue_type] || 0) + 1;
      }
      
      existingData.equipment[equipmentId] = {
        ...existing,
        claims_count: newCount,
        approval_rate: (existing.approval_rate * existing.claims_count + (approved ? 1 : 0)) / newCount,
        issue_types: updatedIssueCounts,
        avg_age_at_failure: equipment_age ? 
          (existing.avg_age_at_failure * existing.claims_count + equipment_age) / newCount :
          existing.avg_age_at_failure,
        recent_claims: [claim_id, ...existing.recent_claims].slice(0, 10)
      };
    } else if (existingData.equipment) {
      existingData.equipment[equipmentId] = newTrend;
    } else {
      existingData.equipment = {
        [equipmentId]: newTrend
      };
    }
    
    await updateVault(this.orgId, 'equipment_trends', existingData);
  }
  
  // Query the vault for organization-specific recommendations
  async getRecommendations(context: any): Promise<any> {
    const { 
      claim_type, 
      vendor_id, 
      equipment_id, 
      equipment_model,
      user_id,
      issue_description 
    } = context;
    
    // Build recommendation context from org vaults
    const claimPatternsVault = await getVaultByType(this.orgId, 'claim_patterns');
    const vendorInsightsVault = await getVaultByType(this.orgId, 'vendor_insights');
    const equipmentTrendsVault = await getVaultByType(this.orgId, 'equipment_trends');
    const techBehaviorsVault = await getVaultByType(this.orgId, 'tech_behaviors');
    
    // Compile all relevant organizational knowledge
    const orgKnowledge = {
      claim_patterns: claimPatternsVault?.data || {},
      vendor_insights: vendor_id && vendorInsightsVault?.data?.vendors?.[vendor_id] || {},
      equipment_trends: equipment_id && equipmentTrendsVault?.data?.equipment?.[equipment_id] || {},
      tech_behavior: user_id && techBehaviorsVault?.data?.techs?.[user_id] || {}
    };
    
    // Log this retrieval event
    if (claimPatternsVault) {
      await logVaultEvent(
        this.orgId,
        claimPatternsVault.id,
        'retrieval',
        { context }
      );
    }
    
    // Integrate with MCP7 memory layer
    const mcpRecommendations = await this.mcpManager.getRecommendations({
      ...context,
      org_knowledge: orgKnowledge
    });
    
    // Generate org-specific recommendations by enriching MCP recommendations
    const recommendations = this.enhanceRecommendationsWithOrgInsights(
      mcpRecommendations,
      orgKnowledge
    );
    
    return recommendations;
  }
  
  // Enhance MCP recommendations with organization-specific insights
  private enhanceRecommendationsWithOrgInsights(
    mcpRecommendations: any,
    orgKnowledge: Record<string, any>
  ): any {
    // Start with MCP recommendations
    const enhancedRecommendations = [...mcpRecommendations];
    
    // Add organization-specific advice based on learning vaults
    if (orgKnowledge.vendor_insights?.approval_rate < 0.4) {
      enhancedRecommendations.push({
        type: 'org_insight',
        confidence: 0.85,
        title: 'Based on your organization\'s history',
        message: 'This vendor has a low approval rate with your team. Consider gathering additional evidence before submitting.',
        action: 'evidence_preparation'
      });
    }
    
    if (orgKnowledge.equipment_trends?.issue_types) {
      // Find most common issue for this equipment
      const issueTypes = orgKnowledge.equipment_trends.issue_types;
      const mostCommonIssue = Object.keys(issueTypes).reduce(
        (max, type) => issueTypes[type] > issueTypes[max] ? type : max, 
        Object.keys(issueTypes)[0]
      );
      
      enhancedRecommendations.push({
        type: 'org_insight',
        confidence: 0.75,
        title: 'Equipment-specific advice',
        message: `This model commonly experiences "${mostCommonIssue}" issues in your organization. Consider highlighting this pattern to the vendor.`,
        action: 'highlight_pattern'
      });
    }
    
    return enhancedRecommendations;
  }
  
  // Train the learning vault with explicit feedback
  async trainWithFeedback(
    feedbackData: any, 
    vaultType: VaultType, 
    userId?: string
  ): Promise<boolean> {
    const vault = await getVaultByType(this.orgId, vaultType);
    
    if (!vault) {
      console.error(`Cannot train non-existent vault: ${vaultType}`);
      return false;
    }
    
    // Log the training event
    await logVaultEvent(
      this.orgId,
      vault.id,
      'training',
      feedbackData,
      userId
    );
    
    // Update the vault with the training data
    const updatedData = this.applyTrainingToVault(vault.data, feedbackData, vaultType);
    
    return await updateVault(
      this.orgId,
      vaultType,
      updatedData,
      userId
    );
  }
  
  // Apply training feedback to vault data
  private applyTrainingToVault(
    currentData: Record<string, any>,
    feedbackData: any,
    vaultType: VaultType
  ): Record<string, any> {
    // Implementation would vary by vault type
    switch (vaultType) {
      case 'claim_patterns':
        // Update claim pattern weights based on feedback
        if (feedbackData.issue_type && currentData.patterns?.[feedbackData.issue_type]) {
          const pattern = currentData.patterns[feedbackData.issue_type];
          pattern.weight = (pattern.weight || 1) * feedbackData.effectiveness;
        }
        break;
        
      case 'vendor_insights':
        // Update vendor insight confidence based on feedback
        if (feedbackData.vendor_id && currentData.vendors?.[feedbackData.vendor_id]) {
          const vendor = currentData.vendors[feedbackData.vendor_id];
          vendor.confidence_score = (vendor.confidence_score || 0.5) * 0.8 + feedbackData.accuracy * 0.2;
        }
        break;
        
      // Other vault types...
    }
    
    return currentData;
  }
  
  // Expose introspect endpoint data
  async getIntrospectData(): Promise<Record<string, any>> {
    const vaultTypes: VaultType[] = [
      'claim_patterns',
      'vendor_insights',
      'equipment_trends',
      'tech_behaviors'
    ];
    
    const vaults = await Promise.all(
      vaultTypes.map(async (type) => {
        const vault = await getVaultByType(this.orgId, type);
        return {
          type,
          exists: !!vault,
          version: vault?.version || 0,
          last_updated: vault?.updated_at || null,
          data_points: vault ? this.countDataPoints(vault.data, type) : 0
        };
      })
    );
    
    return {
      org_id: this.orgId,
      vaults: vaults.reduce((acc, vault) => {
        acc[vault.type] = {
          exists: vault.exists,
          version: vault.version,
          last_updated: vault.last_updated,
          data_points: vault.data_points
        };
        return acc;
      }, {} as Record<string, any>)
    };
  }
  
  // Count data points in a vault for introspection
  private countDataPoints(data: Record<string, any>, type: VaultType): number {
    switch (type) {
      case 'claim_patterns':
        return Object.keys(data.patterns || {}).length;
      case 'vendor_insights':
        return Object.keys(data.vendors || {}).length;
      case 'equipment_trends':
        return Object.keys(data.equipment || {}).length;
      case 'tech_behaviors':
        return Object.keys(data.techs || {}).length;
      default:
        return 0;
    }
  }
}
