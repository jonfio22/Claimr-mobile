export async function integrateWithClaimWorkflow(
  claimData: any,
  orgId: string,
  mcpManager: MCP7MemoryManager
): Promise<void> {
  const vaultService = new OrgLearningVaultService(orgId, mcpManager);
  
  // Process the claim for organizational learning
  await vaultService.processClaimForLearning(claimData);
  
  // Update MCP memory stream with organization context
  await mcpManager.addToMemoryStream({
    event_type: 'claim_creation',
    data: claimData,
    metadata: {
      org_id: orgId,
      org_context: true
    }
  });
