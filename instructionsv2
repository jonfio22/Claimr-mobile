export async function handleIntrospectRequest(
  req: any,
  res: any
): Promise<void> {
  const { org_id } = req.query;
  
  if (!org_id) {
    res.status(400).json({ error: 'Missing organization ID' });
    return;
  }
  
  const mcpManager = new MCP7MemoryManager();
  const vaultService = new OrgLearningVaultService(org_id, mcpManager);
  
  try {
    const introspectData = await vaultService.getIntrospectData();
    res.status(200).json(introspectData);
  } catch (error) {
    console.error('Error in introspect handler:', error);
    res.status(500).json({ error: 'Failed to retrieve introspect data' });
  }
}
