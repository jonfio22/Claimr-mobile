### 3. ⚠️ Incomplete MCP7 tool validation – Some tools not verified

**Finding:**
The Modular Control Protocol 7 (MCP7) core has incomplete tool validation, with some tools not being properly verified.

**Remediation:**
```typescript
// lib/mcp7/toolValidator.ts
import { z } from 'zod';
import { Tool, ToolPermission, ToolResults } from '../../types/mcp7';

// Schema definitions for tool validation
const toolBaseSchema = z.object({
  id: z.string().uuid(),
  name: z.string().min(1),
  description: z.string(),
  version: z.string().regex(/^\d+\.\d+\.\d+$/),
  permissions: z.array(z.nativeEnum(ToolPermission)),
  inputSchema: z.any(), // Will be further validated
  outputSchema: z.any(), // Will be further validated
});

const inputOutputSchemaValidator = (schema: any): boolean => {
  try {
    // Validate schema structure based on JSON Schema standard
    const schemaValidator = z.object({
      type: z.string(),
      properties: z.record(z.any()).optional(),
      required: z.array(z.string()).optional(),
      // Add other JSON Schema fields as needed
    });
    
    schemaValidator.parse(schema);
    return true;
  } catch (error) {
    console.error("Schema validation failed:", error);
    return false;
  }
};

export class MCP7ToolValidator {
  // Validate tool registration
  static validateToolRegistration(tool: Tool): { valid: boolean; errors: string[] } {
    try {
      toolBaseSchema.parse(tool);
      
      const errors: string[] = [];
      
      // Validate input schema
      if (!inputOutputSchemaValidator(tool.inputSchema)) {
        errors.push(`Invalid input schema for tool ${tool.name}`);
      }
      
      // Validate output schema
      if (!inputOutputSchemaValidator(tool.outputSchema)) {
        errors.push(`Invalid output schema for tool ${tool.name}`);
      }
      
      // Validate tool-specific requirements
      if (tool.permissions.includes(ToolPermission.FILE_SYSTEM) && !tool.securityReview) {
        errors.push(`Tool ${tool.name} requires security review for file system access`);
      }
      
      return {
        valid: errors.length === 0,
        errors
      };
    } catch (error) {
      return {
        valid: false,
        errors: [(error as Error).message]
      };
    }
  }
  
  // Validate tool execution results
  static validateToolResults(tool: Tool, results: ToolResults): { valid: boolean; errors: string[] } {
    try {
      // Parse result against tool's output schema
      const outputValidator = this.createSchemaValidator(tool.outputSchema);
      outputValidator.parse(results.data);
      
      return { valid: true, errors: [] };
    } catch (error) {
      return {
        valid: false,
        errors: [(error as Error).message]
      };
    }
  }
  
  // Create Zod validator from JSON Schema
  private static createSchemaValidator(schema: any): z.ZodType<any> {
    // Simple implementation - in production, use a complete JSON Schema to Zod converter
    if (schema.type === 'object') {
      const shape: Record<string, z.ZodType<any>> = {};
      
      if (schema.properties) {
        Object.entries(schema.properties).forEach(([key, propSchema]: [string, any]) => {
          shape[key] = this.createPropertyValidator(propSchema);
        });
      }
      
      let zodObject = z.object(shape);
      
      if (schema.required && Array.isArray(schema.required)) {
        schema.required.forEach((field: string) => {
          if (shape[field]) {
            shape[field] = shape[field].required();
          }
        });
      }
      
      return zodObject;
    }
    
    // Default fallback
    return z.any();
  }
  
  private static createPropertyValidator(propSchema: any): z.ZodType<any> {
    switch (propSchema.type) {
      case 'string':
        return z.string();
      case 'number':
        return z.number();
      case 'boolean':
        return z.boolean();
      case 'array':
        return z.array(this.createPropertyValidator(propSchema.items || {}));
      case 'object':
        return this.createSchemaValidator(propSchema);
      default:
        return z.any();
    }
  }
}

// Implementation for tool validation system
export async function validateAllRegisteredTools() {
  const { data: tools, error } = await supabase
    .from('mcp7_tools')
    .select('*');
  
  if (error || !tools) {
    console.error("Failed to fetch tools:", error);
    return;
  }
  
  const validationResults = tools.map(tool => ({
    tool,
    validation: MCP7ToolValidator.validateToolRegistration(tool)
  }));
  
  const invalidTools = validationResults.filter(r => !r.validation.valid);
  
  if (invalidTools.length > 0) {
    console.error(`Found ${invalidTools.length} invalid tools:`);
    invalidTools.forEach(r => {
      console.error(`Tool ${r.tool.name}: ${r.validation.errors.join(', ')}`);
    });
  } else {
    console.log(`All ${tools.length} tools validated successfully`);
  }
}
